              ]
            },
            "description": "Update user information"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "users",
                "{{user_id}}"
              ]
            },
            "description": "Delete user (soft delete)"
          }
        }
      ],
      "description": "User Management endpoints (Private - Admin operations, all require authentication)"
    },
