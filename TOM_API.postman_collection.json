              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Jane\",\n  \"last_name\": \"Doe\",\n  \"phone\": \"+65 9876 5432\",\n  \"department\": \"Sales\"\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users/{{user_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
