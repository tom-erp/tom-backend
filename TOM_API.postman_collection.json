        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@tom.com\",\n  \"password\": \"password123\",\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"role\": \"site_engineer\",\n  \"phone\": \"+65 1234 5678\",\n  \"department\": \"Engineering\",\n  \"organization_id\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}{{api_prefix}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "{{api_prefix}}",
                "users"
              ]
            },
            "description": "Admin operation - Create a new user account (requires authentication). Use this for admin creating employee accounts."
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
